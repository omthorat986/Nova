{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NovaScopedS3PrefixOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::amzn-nova-deploy/uploads/*",
        "arn:aws:s3:::amzn-nova-deploy/avatars/*",
        "arn:aws:s3:::amzn-nova-deploy/banners/*",
        "arn:aws:s3:::amzn-nova-deploy/agencies/*",
        "arn:aws:s3:::amzn-nova-deploy/outreach/*",
        "arn:aws:s3:::amzn-nova-deploy/backups/*"
      ]
    },
    {
      "Sid": "NovaScopedS3BucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::amzn-nova-deploy",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "uploads/*",
            "avatars/*",
            "banners/*",
            "agencies/*",
            "outreach/*",
            "backups/*"
          ]
        }
      }
    },
    {
      "Sid": "NovaCloudWatchLoggingPermissions",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:us-east-1:*:log-group:/nova/*"
    },
    {
      "Sid": "NovaCloudWatchMetricsPush",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "NovaSpace/ObservatoryMetrics"
        }
      }
    },
    {
      "Sid": "NovaScopedSESOutreachEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-1:610156625955:identity/*"
    }
  ]
}
