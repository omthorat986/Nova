{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NovaScopedS3UploadsAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/uploads/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/avatars/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/banners/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/agencies/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/outreach/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/backups/*"
      ]
    },
    {
      "Sid": "NovaScopedSESOutreachEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-1:YOUR_ACCOUNT_ID:identity/noreply@nova.local"
    }
  ]
}
