{
  "Version": "2012-10-17",
  "Id": "NovaHardenedS3BucketPolicy",
  "Statement": [
    {
      "Sid": "EnforceTLSRequestsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::amzn-nova-deploy",
        "arn:aws:s3:::amzn-nova-deploy/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyUnencryptedObjectUploads",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::amzn-nova-deploy/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "ExplicitAllowForEC2ServerRoleOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::610156625955:role/NovaEC2ServerRole"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::amzn-nova-deploy/uploads/*",
        "arn:aws:s3:::amzn-nova-deploy/avatars/*",
        "arn:aws:s3:::amzn-nova-deploy/banners/*",
        "arn:aws:s3:::amzn-nova-deploy/agencies/*",
        "arn:aws:s3:::amzn-nova-deploy/outreach/*",
        "arn:aws:s3:::amzn-nova-deploy/backups/*"
      ]
    }
  ]
}
