{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/nova/logs/app.log",
            "log_group_name": "/nova/app",
            "log_stream_name": "{instance_id}-app-log",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S",
            "timezone": "UTC",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/nova/logs/access.log",
            "log_group_name": "/nova/access",
            "log_stream_name": "{instance_id}-access-log",
            "timezone": "UTC",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/nova/logs/audit.log",
            "log_group_name": "/nova/audit",
            "log_stream_name": "{instance_id}-audit-log",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S",
            "timezone": "UTC",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/nova/nginx/access",
            "log_stream_name": "{instance_id}-nginx-access",
            "timezone": "UTC",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/nova/nginx/error",
            "log_stream_name": "{instance_id}-nginx-error",
            "timezone": "UTC",
            "retention_in_days": 14
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "NovaSpace/ObservatoryMetrics",
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "disk_used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    }
  }
}
