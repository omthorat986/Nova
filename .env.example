# ==============================================================================
# NOVA Observatory — Production Environment Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env (or /etc/nova/nova.env on EC2)
# 2. Populate with your environment-specific values
# 3. Restrict permissions: chmod 600 .env
# 4. NEVER commit the active .env file or real credentials to git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Mode
# ------------------------------------------------------------------------------
# Environment: 'production', 'development', or 'testing'
# In 'production': Debugging is forced OFF, secure cookies are enforced,
# and the app strictly validates that secrets and cloud parameters are set.
APP_ENV=production
ENV=production

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Session Secret
# ------------------------------------------------------------------------------
# High-entropy secret key used for session signing and CSRF tokens.
# Must be at least 32 characters long in production.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_character_cryptographically_secure_random_hex_string

# ------------------------------------------------------------------------------
# 3. AWS Cloud Storage (Amazon S3)
# ------------------------------------------------------------------------------
# Storage engine mode: 's3' for production AWS, 'local' for offline dev.
STORAGE_MODE=s3

# Unique name of your private Amazon S3 bucket (Block Public Access ENABLED).
# Example: nova-observatory-prod-123456789012
S3_BUCKET=replace_with_your_actual_s3_bucket_name

# Target AWS region hosting your S3 bucket and EC2 instance.
AWS_REGION=us-east-1

# Time-to-live (in seconds) for temporary presigned GET URLs generated for private media.
S3_URL_EXPIRATION_SECONDS=300

# ------------------------------------------------------------------------------
# 4. Database Storage (SQLite / Future RDS)
# ------------------------------------------------------------------------------
# Absolute filesystem path to the production SQLite database file.
# Ensured with WAL mode, foreign keys ON, and 5000ms busy timeout.
NOVA_DB_PATH=/var/lib/nova/nova.db

# ------------------------------------------------------------------------------
# 5. Domain, Host & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed host header values (Nginx / CloudFront).
# Example: novagallery.duckdns.org,localhost
ALLOWED_HOSTS=novagallery.duckdns.org,localhost,127.0.0.1

# Cookie security: Set to 'true' in production behind HTTPS/TLS termination.
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 6. Session Lifecycle Timers
# ------------------------------------------------------------------------------
# Inactivity idle timeout (in minutes) before observer re-authentication is required.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Hard session ceiling (in hours) after which a fresh login is mandatory.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ------------------------------------------------------------------------------
# 7. Brute-Force Protection & Rate Limiting
# ------------------------------------------------------------------------------
# Maximum failed login attempts allowed per account/IP before temporary lockout.
LOGIN_MAX_ATTEMPTS=5

# Duration of temporary lockout (in minutes) upon exceeding login attempts.
LOGIN_LOCKOUT_MINUTES=15

# Rate limit for media uploads per observer per hour (prevents storage flooding).
UPLOAD_RATE_LIMIT_HOURLY=5

# ------------------------------------------------------------------------------
# 8. External APIs & Telemetry Integrations
# ------------------------------------------------------------------------------
# NASA Open API Key for Astronomy Picture of the Day & NASA telemetry.
# Register for free at https://api.nasa.gov or leave DEMO_KEY for low rate limits.
NASA_API_KEY=DEMO_KEY

# Research outreach delivery mode: 'ses' (Amazon SES) or 'local' (copy drafts).
EMAIL_MODE=local

# Verified recipient email identity registered in Amazon SES (if EMAIL_MODE=ses).
SES_RECIPIENT_CONFIG=mission-control@nova.space

# ------------------------------------------------------------------------------
# 9. Logging & Telemetry Level
# ------------------------------------------------------------------------------
# Log level: 'INFO', 'WARNING', 'ERROR', or 'DEBUG' (CloudWatch agent compatible).
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 10. Gunicorn WSGI Server Settings
# ------------------------------------------------------------------------------
# Local loopback socket for Gunicorn behind Nginx.
GUNICORN_BIND=127.0.0.1:8080

# Worker processes (recommended: 2 for t3.micro with SQLite concurrency).
GUNICORN_WORKERS=2
